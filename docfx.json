{
  "metadata": [
    {
      "src": [
        {
          "files": [ "BOOSEapplication/BOOSEapplication.csproj" ],
          "src": ".."
        },
        {
          "files": [ "BOOSEapplication.Tests/BOOSEapplication.Tests.csproj" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ],
        "exclude": [ "api/**.cs", "api/**/*.cs" ]
      },
      {
        "files": [ "*.md", "toc.yml" ],
        "exclude": [ "obj/**", "bin/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "output": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [ "default", "modern" ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": true
  }
}